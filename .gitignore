# macOS Finder metadata
.DS_Store

# Swift Package Manager and Xcode build products
CodexUsageMonitor/.build/
CodexUsageMonitor/.swiftpm/
CodexUsageMonitor/DerivedData/
CodexUsageMonitor/**/*.xcuserdatad/
CodexUsageMonitor/**/*.xcscmblueprint

# Isolated feature worktrees
.worktrees/

# Python caches and local environments
**/__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Live probe output: can contain account usage and local machine metadata
UsageProbe/Outputs/*
!UsageProbe/Outputs/.gitkeep

# Local credentials, quota caches, and environment overrides
.env
.env.*
!.env.example
**/auth.json
**/last-known-good.json
**/quota-history.json
.codex-usage-probe/

# Local logs
*.log

# Agent skills synced in from global/third-party sources — tooling for whoever
# is working here, not project assets. The repo's *own* skills stay tracked:
# preparing-evidence-rich-prs is referenced by docs/development/ and .github/.
.agents/skills/*
!.agents/skills/preparing-evidence-rich-prs/

# Per-machine agent harness config and the skill manifest that regenerates.
.claude/
skills-lock.json

# Raw Figma exports and screen recordings: large, regenerated, and the v6
# design is preserved as tracked spec + source in docs/design/menu-bar-popover/.
High-fidelity macOS menu UI*/
High-fidelity macOS menu UI*.zip
*.mov
