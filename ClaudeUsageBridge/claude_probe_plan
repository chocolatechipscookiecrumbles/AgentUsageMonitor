3. Provider coordinator

Create a single entry point comparable to the existing Codex quota collector.

protocol ClaudeUsageSourceProtocol: Sendable {
    func fetch() async throws -> ClaudeUsageSnapshot
}
actor ClaudeUsageCollector {
    private let oauthSource: ClaudeOAuthUsageSource
    private let statusLineSource: ClaudeStatusLineUsageSource
    private let cliSource: ClaudeCLIUsageSource
    private let cache: ClaudeUsageCache
    private let settings: ClaudeProviderSettingsStore
    func refresh(
        reason: ClaudeRefreshReason
    ) async -> ClaudeUsagePresentation
}

Refresh reasons:

enum ClaudeRefreshReason: Sendable {
    case appLaunch
    case scheduled
    case menuOpened
    case networkRecovered
    case userInitiated
    case forcedCLI
}

The refresh reason controls whether CLI probing is eligible.

Decision algorithm

func refresh(
    reason: ClaudeRefreshReason
) async -> ClaudeUsagePresentation {
    do {
        let result = try await oauthSource.fetch()
        try await cache.save(result)
        return .live(result)
    } catch {
        recordSourceFailure(.oauth, error)
    }
    if let passive = try? await statusLineSource.readLatest(),
       freshnessPolicy.canUseStatusLine(passive, for: reason) {
        try? await cache.save(passive)
        return .passive(passive)
    }
    if reason.allowsCLIProbe,
       await settings.isCLIProbeAuthorized {
        do {
            let result = try await cliSource.fetch()
            try await cache.save(result)
            return .live(result)
        } catch {
            recordSourceFailure(.cliUsage, error)
        }
    }
    if let cached = try? await cache.load() {
        return .cached(cached)
    }
    throw ClaudeUsageError.noUsableSource
}

Do not simply swallow all errors. Preserve source-specific failures so the settings screen can explain why OAuth, status-line capture, or CLI fallback did not work.

